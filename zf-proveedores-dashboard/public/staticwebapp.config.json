{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/data/*", "/*.{svg,png,ico,json,txt}"]
  },
  "routes": [
    {
      "route": "/data/*",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
